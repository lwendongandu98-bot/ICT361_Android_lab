<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- TOOLBAR MATCHING DASHBOARD THEME -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarLabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="#1565C0">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Lab Management"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- MAIN SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Lab Title -->
            <EditText
                android:id="@+id/etLabTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:hint="Lab Title"
                android:inputType="textCapWords"
                android:background="@android:drawable/editbox_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical" />

            <!-- Lab Description -->
            <EditText
                android:id="@+id/etLabDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:hint="Lab Description"
                android:inputType="textMultiLine"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp" />

            <!-- Due Date (Numeric input paired with auto-formatter) -->
            <EditText
                android:id="@+id/etDueDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:hint="Due Date (DD/MM/YYYY)"
                android:inputType="number"
                android:maxLength="10"
                android:background="@android:drawable/editbox_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical" />

            <!-- Choose File Button -->
            <Button
                android:id="@+id/btnChooseFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Choose Lab File"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF" />

            <!-- Draft Button -->
            <Button
                android:id="@+id/btnSaveDraft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1565C0"
                android:text="Save Draft"
                android:textColor="#FFFFFF" />

            <!-- Publish Button -->
            <Button
                android:id="@+id/btnPublishLab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1565C0"
                android:text="Publish Now"
                android:textColor="#FFFFFF" />

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"/>

            <!-- Uploaded Labs Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploaded Labs"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <LinearLayout
                android:id="@+id/labsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>