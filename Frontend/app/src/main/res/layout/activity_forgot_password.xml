<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvResetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recover Password"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvResetInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your Username and Recovery Email to retrieve your account password details."
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp" />

    <!-- Username verification entry element field -->
    <EditText
        android:id="@+id/etRecoverUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your username"
        android:inputType="text"
        android:minHeight="48dp"
        android:paddingLeft="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginBottom="16dp" />

    <!-- Email verification entry element field -->
    <EditText
        android:id="@+id/etRecoverEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter recovery email address"
        android:inputType="textEmailAddress"
        android:minHeight="48dp"
        android:paddingLeft="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginBottom="24dp" />

    <!-- Recover Submission Action Button Button -->
    <Button
        android:id="@+id/btnRecoverSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find Password"
        android:textSize="16sp"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:minHeight="48dp"
        android:layout_marginBottom="24dp" />

    <!-- Back to Login Navigation Option -->
    <TextView
        android:id="@+id/tvBackToLoginFromRecover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back to Login"
        android:textColor="#1976D2"
        android:layout_gravity="center_horizontal"
        android:padding="8dp"/>

</LinearLayout>
