<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- Screen Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Groups Management"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#311B92" />

    <!-- Section: Create New Group -->
    <EditText
        android:id="@+id/etGroupName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:hint="Enter Group Name (e.g., Group A)"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>

    <Button
        android:id="@+id/btnCreateGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Create Group"
        android:backgroundTint="#311B92"
        android:textColor="#FFFFFF" />

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"/>

    <!-- Section: Filter/Search Existing Groups -->
    <EditText
        android:id="@+id/etSearchGroups"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="🔍 Search active lab batches..."
        android:inputType="text"
        android:textSize="14sp"
        android:background="@android:drawable/editbox_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Lab Batches"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <!-- Scrollable content area for inflated group rows -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/groupsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
