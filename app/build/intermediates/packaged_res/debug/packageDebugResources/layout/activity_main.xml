<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical"
    android:background="#FFFFFF">

    <!-- App Logo / Icon -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_menu_agenda"
        app:tint="#0D47A1" />
    <!-- Note: Replace @android:drawable/ic_menu_agenda with your graduation cap vector drawable asset -->

    <!-- Main Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Lab\nGroup Management"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Tagline text seen below the title -->
    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Organize • Collaborate • Succeed"
        android:textSize="14sp"
        android:textColor="#757575"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp" />

    <!-- Username Input with Person Icon -->
    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Username / Student number"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:drawableStart="@android:drawable/ic_menu_myplaces"
        android:drawablePadding="10dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginBottom="16dp" />
    <!-- Note: Replace @android:drawable/ic_menu_myplaces with a person icon asset -->

    <!-- Password Input with Lock Icon -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:drawableStart="@android:drawable/ic_secure"
        android:drawablePadding="10dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginBottom="20dp" />
    <!-- Note: Replace @android:drawable/ic_secure with a lock icon asset -->

    <!-- Role Selection Radio Group -->
    <RadioGroup
        android:id="@+id/rgRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/rbStudent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student"
            android:checked="true"
            android:layout_marginEnd="32dp" />

        <RadioButton
            android:id="@+id/rbLecturer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lecturer" />

    </RadioGroup>

    <!-- Rounded Login Button -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login"
        android:textSize="16sp"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:minHeight="50dp"
        android:layout_marginBottom="24dp" />

    <!-- Forgot Password Link -->
    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password?"
        android:textColor="#1976D2"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:padding="8dp" />

    <!-- Registration Link -->
    <TextView
        android:id="@+id/tvRegisterLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't have an account? Register"
        android:textColor="#1976D2"
        android:layout_gravity="center_horizontal"
        android:padding="8dp" />

</LinearLayout>
