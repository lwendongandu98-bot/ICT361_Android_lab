<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/blue_primary">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/baseline_home_24"
            app:tint="@android:color/white"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Student Profile"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>

    </LinearLayout>

    <!-- CONTENT SCROLLER -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- PROFILE IMAGE CONTAINER WITH CAMERA BADGE -->
            <FrameLayout
                android:id="@+id/profileImageContainer"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/circle_profile"
                    android:backgroundTint="@color/blue_primary"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="@android:color/white" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="Edit Account Details"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"/>

            <!-- EDITABLE FIELDS -->
            <EditText
                android:id="@+id/etStudentName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/dashboard_card"
                android:backgroundTint="#FFFFFF"
                android:hint="Full Name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:textColor="#000000"/>

            <EditText
                android:id="@+id/etStudentEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/dashboard_card"
                android:backgroundTint="#FFFFFF"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:textColor="#000000"/>

            <EditText
                android:id="@+id/etStudentProgram"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/dashboard_card"
                android:backgroundTint="#FFFFFF"
                android:hint="Program / Course"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:textColor="#000000"/>

            <EditText
                android:id="@+id/etStudentAge"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/dashboard_card"
                android:backgroundTint="#FFFFFF"
                android:hint="Age / Year"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:textColor="#000000"/>

            <!-- UPDATE BUTTON -->
            <Button
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/blue_primary"
                android:text="Update Profile"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="8dp"/>

            <!-- BACK TO DASHBOARD BUTTON -->
            <Button
                android:id="@+id/btnBackToDashboard"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@android:color/white"
                android:text="BACK TO DASHBOARD"
                android:textColor="@color/blue_primary"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                style="?attr/materialButtonOutlinedStyle"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>