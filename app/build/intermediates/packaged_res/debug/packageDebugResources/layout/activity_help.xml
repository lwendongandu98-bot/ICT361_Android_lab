<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarHelp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1557B0"
        android:title="Help and Support"
        android:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Frequently Asked Questions"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1557B0"
                android:paddingBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. How do I manage lab groups?\nNavigate to the Groups section from your dashboard to view, create, or organize student lab groups.\n\n2. How do I view student submissions?\nTap on Submissions from the main dashboard or navigation menu to check assignments submitted by students.\n\n3. How do I update my profile details?\nGo to Settings, select Edit Profile, and update your personal information or profile picture."
                android:textSize="14sp"
                android:textColor="#333333"
                android:lineSpacingExtra="6dp"
                android:paddingBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Need Further Assistance?"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1557B0"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If you encounter any technical issues or have inquiries, please contact the system administrator or IT support team at support@studentlabgroupmanagement.com."
                android:textSize="14sp"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>