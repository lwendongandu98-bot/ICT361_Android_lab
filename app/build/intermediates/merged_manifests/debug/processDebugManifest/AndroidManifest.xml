<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.studentlabgroupmanagement"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="37" />

    <permission
        android:name="com.example.studentlabgroupmanagement.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.studentlabgroupmanagement.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.StudentLabGroupManagement" >

        <!-- Main/Login Activity -->
        <activity
            android:name="com.example.studentlabgroupmanagement.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registration -->
        <activity
            android:name="com.example.studentlabgroupmanagement.StudentRegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.LecturerRegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboards -->
        <activity
            android:name="com.example.studentlabgroupmanagement.StudentHomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.LecturerHomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Lecturer Profile -->
        <activity
            android:name="com.example.studentlabgroupmanagement.LecturerProfileActivity"
            android:exported="false" />

        <!-- Features -->
        <activity
            android:name="com.example.studentlabgroupmanagement.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.StudentProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.TimetableActivity"
            android:exported="false" />
        <activity
            android:name="com.example.studentlabgroupmanagement.TasksActivity"
            android:exported="false" />
        <activity
            android:name="com.example.studentlabgroupmanagement.NotificationActivity"
            android:exported="false" />
        <activity
            android:name="com.example.studentlabgroupmanagement.GroupsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.studentlabgroupmanagement.StudentsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.studentlabgroupmanagement.AnnouncementsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.studentlabgroupmanagement.StudentAnnouncementsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.LabsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.studentlabgroupmanagement.SubmissionsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.studentlabgroupmanagement.AssignStudentsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.StudentLabActivity"
            android:exported="false"
            android:label="Student Labs"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.CheckedLabsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.MyGroupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.AddCourseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.studentlabgroupmanagement.provider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="com.example.studentlabgroupmanagement.HelpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.studentlabgroupmanagement.TermsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.studentlabgroupmanagement.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>