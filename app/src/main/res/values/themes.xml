<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.StudentLabGroupManagement" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">#0D47A1</item>
        <item name="colorSecondary">#D32F2F</item>
        <item name="android:statusBarColor">#002171</item>

        <!-- Force Material 3 Input Field text & hint colors to be dark and vivid -->
        <item name="editTextStyle">@style/CustomEditTextStyle</item>
    </style>

    <!-- Custom EditText style to force dark typing text -->
    <style name="CustomEditTextStyle" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">#111111</item>
        <item name="android:textColorHint">#424242</item>
    </style>
</resources>