<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- Group Header & Editing Control Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/txtTargetGroupTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Managing: group a"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#311B92" />

        <Button
            android:id="@+id/btnEditGroupName"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rename"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtTargetGroupCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Occupancy: 0 / 15 Students Max"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp"/>

    <!-- Section: Search and Filter Available Students -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Search &amp; Add Available Students"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#212121"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etSearchAvailable"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="🔍 Search unassigned students by name/ID..."
        android:inputType="text"
        android:textSize="14sp"
        android:background="@android:drawable/editbox_background"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerProgramFilter"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="12dp"/>

    <!-- Scrollable container for available students -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available Students (Click to Add)"
        android:textSize="12sp"
        android:textColor="#757575"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp"
        android:padding="4dp">
        <LinearLayout
            android:id="@+id/containerAvailableStudents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Section: Enrolled Group Roster -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enrolled Members Roster"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#311B92"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/containerGroupMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
